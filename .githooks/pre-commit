#!/bin/sh
# Auto-bump the patch version in .claude-plugin/plugin.json on every commit,
# so each GitHub update carries a new version and `claude plugin update` always
# picks it up. Enable once per clone: git config core.hooksPath .githooks
set -e

MANIFEST=".claude-plugin/plugin.json"
[ -f "$MANIFEST" ] || exit 0

cur=$(grep -oE '"version"[[:space:]]*:[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+"' "$MANIFEST" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
[ -n "$cur" ] || exit 0

major=$(printf '%s' "$cur" | cut -d. -f1)
minor=$(printf '%s' "$cur" | cut -d. -f2)
patch=$(printf '%s' "$cur" | cut -d. -f3)
new="$major.$minor.$((patch + 1))"

sed -i.bak "s/\"version\"[[:space:]]*:[[:space:]]*\"$cur\"/\"version\": \"$new\"/" "$MANIFEST"
rm -f "$MANIFEST.bak"
git add "$MANIFEST"
echo "pre-commit: bumped plugin version $cur -> $new"

# Keep the paste-in playbooks (xsc-ai-playbooks) in sync with the canonical skills.
# Best-effort: skip quietly if the sibling repo or node isn't present; never block
# the commit. The regenerated files live in a *separate* repo, so they can't be
# staged here — commit/push them from there, or just run ./sync.sh (which does).
XSC="../xsc-ai-playbooks"
if [ -d "$XSC" ] && command -v node >/dev/null 2>&1 && [ -f scripts/gen-onboarding.mjs ]; then
  if node scripts/gen-onboarding.mjs >/dev/null 2>&1 && [ -n "$(git -C "$XSC" status --porcelain 2>/dev/null)" ]; then
    echo "pre-commit: regenerated paste-in playbooks in $XSC — commit/push them there or run ./sync.sh"
  fi
fi
